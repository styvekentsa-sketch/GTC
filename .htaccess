# ==========================================================================
#  Global Trading Corporation — Configuration Apache / LiteSpeed
#  1. Base       2. Sécurité       3. Réécriture d'URL
#  4. En-têtes   5. Compression    6. Cache navigateur
# ==========================================================================


# --------------------------------------------------------------------------
# 1. Base
# --------------------------------------------------------------------------
# index.php prioritaire sur un éventuel ancien index.html
DirectoryIndex index.php index.html

# Pas de listage du contenu des dossiers
Options -Indexes

AddDefaultCharset UTF-8

# Types MIME (logo SVG, manifeste, favicon)
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddType application/xml .xml
AddType text/plain .txt
ServerSignature Off


# --------------------------------------------------------------------------
# 2. Sécurité : fichiers interdits
# --------------------------------------------------------------------------
# Fichiers cachés (.htaccess, .env, .git…), sauf .well-known (certificats SSL)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Sauvegardes, journaux, sources et configuration
<FilesMatch "\.(bak|backup|old|orig|sql|sqlite|db|log|ini|env|sh|dist|md|lock|swp)$|~$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|README.*|LICENSE.*)$">
    Require all denied
</FilesMatch>


# --------------------------------------------------------------------------
# 3. Réécriture d'URL
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- HTTPS obligatoire (sauf en local) ---
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # --- Suppression du www (une seule adresse canonique) ---
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # --- Dossiers includes/, data/ et tools/ : jamais accessibles depuis le web ---
    RewriteRule ^(includes|data|tools)(/|$) - [F,L]

    # --- /index.php → / ---
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # --- URL propres : /services, /a-propos, /contact → fichier .php ---
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-z0-9-]+)/?$ $1.php [NC,L]
</IfModule>


# --------------------------------------------------------------------------
# 4. En-têtes de sécurité
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Application installable du Dashboard : le service worker et le manifeste sont toujours revérifiés
# (sinon la mise en cache d'un mois des scripts empêcherait les mises à jour de l'application installée)
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>


# --------------------------------------------------------------------------
# 5. Compression (Brotli si disponible, sinon GZIP)
# --------------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/ld+json application/xml
    AddOutputFilterByType BROTLI_COMPRESS application/manifest+json image/svg+xml image/x-icon font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/ld+json application/xml
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml image/x-icon font/ttf font/otf
</IfModule>


# --------------------------------------------------------------------------
# 6. Cache navigateur
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 hour"
    ExpiresByType text/html                 "access plus 0 seconds"
    # CSS / JS : adresses versionnées (?v=…) par asset_url(), un nouveau fichier est donc chargé dès sa mise à jour
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType application/xml           "access plus 1 day"
    ExpiresByType text/xml                  "access plus 1 day"
    ExpiresByType text/plain                "access plus 1 day"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>
